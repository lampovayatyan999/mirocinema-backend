{
  "compilerOptions": {
    "module": "node16",
    "target": "es2024",
    "moduleResolution": "node16",
    "resolvePackageJsonExports": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": false,
    "types": ["node"]
  }
}